# Barreira 1 de 3: roda no `git commit`, antes do commit existir.
# Só olha o que está no index — rápido, e é o ponto onde ainda é barato corrigir.
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 não encontrado; instale o Python 3 para rodar o gate." >&2
    exit 1
fi

exec python3 tools/check_compliance.py --staged
